SPRING_PROFILES_ACTIVE=prod

DB_NAME=neuroinfogrinder
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_URL=jdbc:postgresql://postgres:5432/neuroinfogrinder

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=change_me_change_me_change_me_change_me
JWT_EXPIRATION_MS=86400000

JAVA_OPTS=-Xms256m -Xmx768m
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

# Public frontend binding. Use 127.0.0.1:8788:80 when an external nginx
# reverse proxy already owns ports 80/443 on the host.
FRONTEND_PORT_BIND=80:80

TDLIB_ENABLED=true
TDLIB_SYNC_ENABLED=true
TDLIB_SYNC_MAX_PARALLELISM=1
TDLIB_SYNC_BATCH_SIZE=1
TDLIB_SYNC_QUEUE_CAPACITY=2
TDLIB_SYNC_FIXED_DELAY_MS=60000
TDLIB_SYNC_INITIAL_DELAY_MS=30000

TDLIB_API_ID=
TDLIB_API_HASH=
TDLIB_DATABASE_ENCRYPTION_KEY=change_me
PHONE_ENCRYPTION_KEY=
PHONE_HASH_KEY=
TDLIB_PROXY_ENABLED=false
TDLIB_PROXY_TYPE=socks5
TDLIB_PROXY_HOST=
TDLIB_PROXY_PORT=0
TDLIB_PROXY_USERNAME=
TDLIB_PROXY_PASSWORD=
TDLIB_PROXY_SECRET=
TDLIB_GIT_REPOSITORY=https://github.com/tdlib/td.git
TDLIB_GIT_COMMIT=e0943d068ce90b5010f1aea946e6901e25b43bf6
TDLIB_BUILD_JOBS=4

CLASSIFICATION_CONTEXT_ENABLED=true
CLASSIFICATION_CONTEXT_WINDOW_MINUTES=10
CLASSIFICATION_CONTEXT_MAX_MESSAGES=30
CLASSIFICATION_CONTEXT_MAX_CHARS=8000
CLASSIFICATION_CONTEXT_REPLY_DEPTH=1
CLASSIFICATION_ANCHOR_MIN_SCORE=3
CLASSIFICATION_CONTEXT_DEDUP_TTL_HOURS=24
PIPELINE_TRACE_RETENTION_DAYS=45
PIPELINE_TRACE_RETENTION_CLEANUP_CRON=0 20 3 * * *

SIGNAL_CLUSTERING_ENABLED=false
SIGNAL_CLUSTERING_INTERVAL_MS=120000
SIGNAL_CLUSTERING_INITIAL_DELAY_MS=30000
SIGNAL_CLUSTERING_EMBEDDING_BATCH_SIZE=25
SIGNAL_CLUSTERING_CLUSTERING_BATCH_SIZE=50
SIGNAL_CLUSTERING_MACRO_MERGE_BATCH_SIZE=10
SIGNAL_CLUSTERING_MIN_SIMILARITY=0.78
SIGNAL_CLUSTERING_MIN_PROBLEM_SCORE=50
SIGNAL_CLUSTERING_MAX_RETRIES=3
SIGNAL_CLUSTERING_MAX_SPAM_SCORE=70

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
