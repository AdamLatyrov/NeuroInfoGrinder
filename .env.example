SPRING_PROFILES_ACTIVE=prod

DB_NAME=neuroinfogrinder
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_URL=jdbc:postgresql://postgres:5432/neuroinfogrinder

REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=change_me_change_me_change_me_change_me
JWT_EXPIRATION_MS=86400000

JAVA_OPTS=-Xms256m -Xmx768m
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=1

TDLIB_ENABLED=true
TDLIB_SYNC_ENABLED=true
TDLIB_SYNC_MAX_PARALLELISM=1
TDLIB_SYNC_BATCH_SIZE=1
TDLIB_SYNC_QUEUE_CAPACITY=2
TDLIB_SYNC_FIXED_DELAY_MS=60000
TDLIB_SYNC_INITIAL_DELAY_MS=30000

TDLIB_API_ID=
TDLIB_API_HASH=
TDLIB_DATABASE_ENCRYPTION_KEY=change_me
TDLIB_RELEASE_URL=https://github.com/all4fun/build-tdlib/releases/download/v1.2.1/tdlib-v1.2.1-linux-amd64.tar.gz

CLASSIFICATION_CONTEXT_ENABLED=true
CLASSIFICATION_CONTEXT_WINDOW_MINUTES=10
CLASSIFICATION_CONTEXT_MAX_MESSAGES=30
CLASSIFICATION_CONTEXT_MAX_CHARS=8000
CLASSIFICATION_CONTEXT_REPLY_DEPTH=1
CLASSIFICATION_ANCHOR_MIN_SCORE=3
CLASSIFICATION_CONTEXT_DEDUP_TTL_HOURS=24

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
